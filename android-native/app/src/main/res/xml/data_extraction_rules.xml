<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The web view's data (the Riot session cookies) stays on this phone: a restored or new phone
     signs in again. Decks, games and settings are backed up as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
